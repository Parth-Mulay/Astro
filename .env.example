# --- APPLICATION SETTINGS ---
# Environment configuration (production/development)
ENVIRONMENT=production

# Logging level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# --- DATABASE SETTINGS ---
# SQLite URL path inside the container/host (use sqlite:////data/app.db for persistent Docker path)
DATABASE_URL=sqlite:////data/app.db

# --- DIRECTORY CONFIGURATIONS ---
# Paths are relative to project root or absolute paths
UPLOADS_DIR=uploads
REPORTS_DIR=reports
LOGS_DIR=logs

# --- SECURITY ---
# Secret key for URLSafeTimedSerializer session token encoding.
# Run 'python -c "import secrets; print(secrets.token_hex(32))"' to generate a strong key.
SESSION_SECRET=your-super-secret-key-change-me-in-production

# Enable secure cookie flag (HTTPS only). Set to true in production behind Nginx SSL.
SECURE_COOKIES=true

# Rate Limiting configuration
RATE_LIMIT_PER_MINUTE=100

# --- RAZORPAY CONFIGURATION (PRODUCTION) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
