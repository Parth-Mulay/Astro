# Python env and cache
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.env

# Database - exclude all EXCEPT the seeded app.db for Vercel deployment
*.sqlite3
*.backup
*.db.backup
# Allow app.db to be committed so Vercel has pre-seeded data
!app.db



